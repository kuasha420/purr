[Desktop Entry]
Name=Smart App Installer
GenericName=Universal Application Installer
Comment=Search and install applications prioritizing System, AUR, Flatpak, and AppImage
Exec=konsole -e /usr/local/bin/smart-install
Icon=system-software-install
Terminal=false
Type=Application
Categories=System;PackageManager;Settings;
Keywords=package;install;pacman;aur;flatpak;appimage;bauh;pamac;
StartupNotify=true
