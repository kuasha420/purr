[Desktop Entry]
Name=Smart App Installer
GenericName=Universal Application Installer & Discovery
Comment=Search and install applications prioritizing System, AUR, Flatpak, and AppImage
Exec=konsole -e smart-install
Icon=smart-install
Terminal=false
Type=Application
