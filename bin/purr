def sigint_handler(signum, frame):
    print(f"\n\n{Colors.CYAN}🐾 Purr session closed peacefully. Goodbye!{Colors.RESET}")
    sys.exit(0)

signal.signal(signal.SIGINT, sigint_handler)

def print_banner():
    print(f"{Colors.BOLD}{Colors.CYAN}===================================================================================={Colors.RESET}")
    print(f"{Colors.BOLD}{Colors.CYAN}        🐾 purr v{__version__} — Universal App Discovery & Priority Installer         {Colors.RESET}")
    print(f"{Colors.DIM}         {__tagline__}{Colors.RESET}")
    print(f"{Colors.DIM}  Hierarchy: [1] System/archlinuxcn -> [2] AUR -> [3] Flatpak -> [4] AppImage -> [5] Git{Colors.RESET}")
    print(f"{Colors.BOLD}{Colors.CYAN}===================================================================================={Colors.RESET}\n")

def notify(title, message, icon="purr"):
    try:
        subprocess.Popen(['notify-send', '-a', 'purr', '-i', icon, title, message],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def normalize(s):
    if not s:
        return ''
    return re.sub(r'[^a-z0-9]', '', str(s).lower())

def get_tokens(s):
    if not s:
        return set()
    return set(re.findall(r'[a-z0-9]+', str(s).lower()))

def score_package(query, name, desc='', is_app=False, votes=0, source='System', display_name=None):
    q_norm = normalize(query)
    n_norm = normalize(name)
    d_norm = normalize(display_name) if display_name else ''
    
    q_tokens = get_tokens(query)
    n_tokens = get_tokens(name)
    d_tokens = get_tokens(desc)

    score = 0.0

    # 0. Direct Alias match
    q_clean = query.strip().lower()
    if q_clean in ALIASES and (name in ALIASES[q_clean] or (display_name and display_name in ALIASES[q_clean])):
        score += 85.0
    elif q_norm in ALIASES and (name in ALIASES[q_norm] or (display_name and display_name in ALIASES[q_norm])):
        score += 85.0

    # 1. Exact & Substring Name Match
    if n_norm == q_norm or (d_norm and d_norm == q_norm):
        score += 100.0
    elif n_norm in [q_norm + 'bin', q_norm + 'desktop', q_norm + 'stable', q_norm + 'appimage']:
        score += 95.0
    elif n_norm.startswith(q_norm) or (d_norm and d_norm.startswith(q_norm)):
        score += 75.0 - min(15.0, len(n_norm) - len(q_norm))
    elif q_tokens.issubset(n_tokens) or (display_name and q_tokens.issubset(get_tokens(display_name))):
        score += 70.0
    elif q_norm in n_norm or (d_norm and q_norm in d_norm):
        score += 50.0
    else:
        overlap = len(q_tokens.intersection(n_tokens))
        if overlap > 0:
            score += (overlap / max(1, len(q_tokens))) * 40.0
        elif q_tokens.issubset(d_tokens):
            score += 25.0
        else:
            sim = max(
                difflib.SequenceMatcher(None, n_norm, q_norm).ratio(),
                difflib.SequenceMatcher(None, d_norm, q_norm).ratio() if d_norm else 0
            )
            score += sim * 30.0

    # 2. Desktop Application verification
    if is_app:
        score += 25.0

    # 3. Penalize auxiliary/plugins/themes/tools/development packages
    penalty_patterns = [
        r'-plugin', r'-extension', r'-theme', r'-skin', r'-addon', r'-mod', 
        r'-wallpapers', r'-debug', r'krunner-', r'uget-integrator', r'^python-', 
        r'^perl-', r'^ruby-', r'^go-', r'browserpass-', r'chromedriver', r'monochrome',
        r'devtools', r'-dkms', r'keyboard_backlight', r'-driver', r'-data$', r'-common$',
        r'-languageserver', r'-language-server', r'-lsp', r'-sdk', r'-daemon', r'-server'
    ]
    for pat in penalty_patterns:
        if re.search(pat, name.lower()) and not any(re.search(pat, t) for t in q_tokens):
            score -= 60.0
            break

    # 4. Dev / Beta channel slight penalty if user searched generic name
    if any(ch in n_norm for ch in ['dev', 'beta', 'canary', 'nightly', 'git']):
        if not any(ch in q_norm for ch in ['dev', 'beta', 'canary', 'nightly', 'git']):
            score -= 15.0

    # 5. Community popularity & source trust
    if votes > 0:
        score += min(30.0, 6.0 * math.log10(votes + 1))
    elif source.startswith('System'):
        score += 15.0

    return round(score, 1)

def search_pacman(query):
    results = {}
    slug = re.sub(r'\s+', '-', query.strip().lower())
    tokens = [t for t in re.findall(r'[a-z0-9]+', query.lower()) if len(t) > 2]
    terms = [slug] + tokens
    if query.strip().lower() in ALIASES:
        terms += ALIASES[query.strip().lower()]

    for term in terms[:4]:
        try:
            proc = subprocess.run(['pacman', '-Ss', term], capture_output=True, text=True, timeout=5)
            lines = proc.stdout.strip().split('\n')
            i = 0
            while i < len(lines):
                line = lines[i].strip()
                if not line:
                    i += 1
                    continue
                if '/' in line:
                    parts = line.split()
                    repo_pkg = parts[0].split('/')
                    repo = repo_pkg[0]
                    pkg_name = repo_pkg[1] if len(repo_pkg) > 1 else parts[0]
                    ver = parts[1] if len(parts) > 1 else ''
                    desc = lines[i+1].strip() if i+1 < len(lines) else ''
                    installed = '[installed]' in line
                    
                    if pkg_name not in results:
                        s = score_package(query, pkg_name, desc, is_app=False, votes=0, source=f'System ({repo})')
                        if s > 0:
                            results[pkg_name] = {
                                'source': f'System ({repo})',
                                'repo': repo,
                                'name': pkg_name,
                                'raw_name': pkg_name,
                                'version': ver,
                                'desc': desc,
                                'installed': installed,
                                'priority': 1,
                                'score': s,
                                'install_cmd': ['sudo', 'pacman', '-S', '--needed', '--noconfirm', '--ask', '4', pkg_name]
                            }
                    i += 2
                else:
                    i += 1
        except Exception:
            pass
    return results

def search_aur(query, exclude_names=None):
    if exclude_names is None:
        exclude_names = set()
    results = {}
    slug = re.sub(r'\s+', '-', query.strip().lower())
    tokens = [t for t in re.findall(r'[a-z0-9]+', query.lower()) if len(t) > 2]
    terms = [slug] + tokens
    if query.strip().lower() in ALIASES:
        terms += [a for a in ALIASES[query.strip().lower()] if not a.startswith('com.') and not a.startswith('org.')]

    seen_aur = {}
    for term in terms[:4]:
        url = f'https://aur.archlinux.org/rpc/v5/search/{urllib.parse.quote(term)}'
        try:
            req = urllib.request.Request(url, headers={'User-Agent': f'Purr/{__version__}'})
            with urllib.request.urlopen(req, timeout=4) as resp:
                data = json.loads(resp.read().decode('utf-8'))
                for r in data.get('results', []):
                    name = r.get('Name')
                    if name and name not in seen_aur:
                        seen_aur[name] = r
        except Exception:
            pass

    for name, p in seen_aur.items():
        if name in exclude_names:
            continue
        desc = p.get('Description') or ''
        votes = p.get('NumVotes') or 0
        ver = p.get('Version') or ''
        s = score_package(query, name, desc, is_app=False, votes=votes, source='AUR')
        if s > 0:
            results[name] = {
                'source': 'AUR',
                'repo': 'aur',
                'name': name,
                'raw_name': name,
                'version': ver,
                'desc': desc,
                'votes': votes,
                'installed': False,
                'priority': 2,
                'score': s,
                'install_cmd': ['yay', '-S', '--needed', '--noconfirm', '--answerclean', 'None', '--answerdiff', 'None', '--answeredit', 'None', '--answerupgrade', 'None', '--overwrite', '*', name]
            }
    return results

def search_flatpak(query):
    results = {}
    try:
        proc = subprocess.run(
            ['flatpak', 'search', '--columns=application,name,version,description', query],
            capture_output=True, text=True, timeout=5
        )
        for line in proc.stdout.strip().split('\n'):
            parts = [p.strip() for p in line.split('\t') if p.strip()]
            if len(parts) >= 2 and not parts[0].startswith('Application'):
                app_id = parts[0]
                disp_name = parts[1] if len(parts) > 1 else app_id
                ver = parts[2] if len(parts) > 2 else ''
                desc = parts[3] if len(parts) > 3 else ''
                s = score_package(query, app_id, desc, is_app=True, votes=0, source='Flatpak', display_name=disp_name)
                if s > 0:
                    results[app_id] = {
                        'source': 'Flatpak (Flathub)',
                        'repo': 'flathub',
                        'name': f"{disp_name} ({app_id})",
                        'raw_name': app_id,
                        'pkg_id': app_id,
                        'version': ver,
                        'desc': desc,
                        'installed': False,
                        'priority': 3,
                        'score': s,
                        'install_cmd': ['flatpak', 'install', '-y', '--noninteractive', 'flathub', app_id]
                    }
    except Exception:
        pass
    return results

def search_appimage(query):
    results = {}
    slug = re.sub(r'\s+', '-', query.strip().lower())
    terms = [f"{slug}-appimage", f"{slug}-bin"]
    for term in terms:
        url = f'https://aur.archlinux.org/rpc/v5/search/{urllib.parse.quote(term)}'
        try:
            req = urllib.request.Request(url, headers={'User-Agent': f'Purr/{__version__}'})
            with urllib.request.urlopen(req, timeout=4) as resp:
                data = json.loads(resp.read().decode('utf-8'))
                for r in data.get('results', []):
                    name = r.get('Name')
                    if name and 'appimage' in name.lower() and name not in results:
                        desc = r.get('Description') or ''
                        votes = r.get('NumVotes') or 0
                        ver = r.get('Version') or ''
                        s = score_package(query, name, desc, is_app=True, votes=votes, source='AppImage')
                        if s > 0:
                            results[name] = {
                                'source': 'AppImage (AUR)',
                                'repo': 'appimage',
                                'name': name,
                                'raw_name': name,
                                'version': ver,
                                'desc': desc,
                                'installed': False,
                                'priority': 4,
                                'score': s,
                                'install_cmd': ['yay', '-S', '--needed', '--noconfirm', '--answerclean', 'None', '--answerdiff', 'None', '--answeredit', 'None', '--answerupgrade', 'None', '--overwrite', '*', name]
                            }
        except Exception:
            pass
    return results

def search_all(query):
    pac_results = search_pacman(query)
    aur_results = search_aur(query, exclude_names=set(pac_results.keys()))
    flatpak_results = search_flatpak(query)
    appimage_results = search_appimage(query)

    # Sort each group
    pac_sorted = sorted(pac_results.values(), key=lambda x: x['score'], reverse=True)
    aur_sorted = sorted(aur_results.values(), key=lambda x: x['score'], reverse=True)
    flatpak_sorted = sorted(flatpak_results.values(), key=lambda x: x['score'], reverse=True)
    appimage_sorted = sorted(appimage_results.values(), key=lambda x: x['score'], reverse=True)

    combined = []
    combined.extend(pac_sorted[:5])
    combined.extend(aur_sorted[:5])
    combined.extend(flatpak_sorted[:4])
    combined.extend(appimage_sorted[:3])

    # Filter out low-confidence noise when high-confidence matches exist
    has_high_confidence = any(x['score'] >= 80.0 for x in combined)
    if has_high_confidence:
        combined = [x for x in combined if x['score'] >= 50.0]

    # Smart Ranking Heuristic:
    # High-confidence matches follow strict hierarchy: System (1) -> AUR (2) -> Flatpak (3) -> AppImage (4)
    combined.sort(key=lambda x: (x['score'] < 75.0, x['priority'], -x['score']))
    return combined

def launch_installed_app(opt):
    name = opt.get('raw_name', opt['name'])
    print(f"\n{Colors.CYAN}🐾 Launching '{name}'...{Colors.RESET}")
    
    if opt['priority'] == 3:
        app_id = opt.get('pkg_id', name)
        subprocess.Popen(['flatpak', 'run', app_id], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        print(f"{Colors.GREEN}[✔] Launched via Flatpak ({app_id}){Colors.RESET}")
        return

    # Check desktop launch via gtk-launch
    for candidate in [name, name.replace('-bin', ''), name.replace('-appimage', ''), name.replace('-git', '')]:
        try:
            proc = subprocess.run(['gtk-launch', candidate], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if proc.returncode == 0:
                print(f"{Colors.GREEN}[✔] Launched '{candidate}' via desktop entry!{Colors.RESET}")
                return
        except Exception:
            pass

    # Check executable in PATH
    clean_name = name.replace('-bin', '').replace('-appimage', '').replace('-git', '')
    cmd = shutil.which(clean_name) or shutil.which(name)
    if cmd:
        subprocess.Popen([cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        print(f"{Colors.GREEN}[✔] Launched executable ({cmd}){Colors.RESET}")
    else:
        print(f"{Colors.YELLOW}[!] Installed successfully. You can launch it from your Application Launcher.{Colors.RESET}")

def run_search_and_install(query=None, dry_run=False):
    if not query:
        print_banner()
        try:
            query = input(f"{Colors.BOLD}Enter application name or keyword to search (or 'q' to exit): {Colors.RESET}").strip()
        except (KeyboardInterrupt, EOFError):
            return False
        
        if not query or query.lower() in ['q', 'exit', 'quit']:
            return False

    print(f"\n{Colors.BOLD}{Colors.CYAN}[*] Searching System Repos, AUR, Flatpak, and AppImage for '{query}'...{Colors.RESET}\n")

    all_options = search_all(query)

    if not all_options:
        print(f"{Colors.YELLOW}[!] No relevant packages found for '{query}'.{Colors.RESET}")
        print(f"\n{Colors.BOLD}Alternative Options:{Colors.RESET}")
        print(f"  [1] Open Bauh Universal GUI Store")
        print(f"  [2] Open Pamac Software Center")
        print(f"  [3] Clone Git Repository & Build Manually")
        print(f"  [s] Search again")
        print(f"  [q] Exit")
        
        try:
            choice = input(f"\n{Colors.BOLD}Select an option: {Colors.RESET}").strip().lower()
        except (KeyboardInterrupt, EOFError):
            return False

        if choice == '1':
            subprocess.Popen(['bauh'], start_new_session=True)
        elif choice == '2':
            subprocess.Popen(['pamac-manager'], start_new_session=True)
        elif choice == '3':
            git_url = input(f"{Colors.BOLD}Enter Git repository URL: {Colors.RESET}").strip()
            if git_url:
                target_dir = os.path.expanduser(f"~/src/{os.path.basename(git_url).replace('.git', '')}")
                os.makedirs(os.path.expanduser("~/src"), exist_ok=True)
                subprocess.run(['git', 'clone', git_url, target_dir])
                print(f"{Colors.GREEN}[+] Cloned to {target_dir}{Colors.RESET}")
                if os.path.exists(os.path.join(target_dir, 'PKGBUILD')):
                    print("Found PKGBUILD! Building package with makepkg...")
                    subprocess.run(['makepkg', '-si', '--noconfirm'], cwd=target_dir)
        elif choice in ['s', '']:
            return True
        return choice != 'q'

    # Print Formatted Ranked Options Table
    print(f"{Colors.BOLD}{'#':<3} {'PRIORITY / SOURCE':<24} {'PACKAGE NAME':<34} {'VERSION':<18} {'STATUS'}{Colors.RESET}")
    print(f"{Colors.DIM}{'-'*98}{Colors.RESET}")

    for idx, opt in enumerate(all_options, 1):
        prio_tag = f"[{opt['priority']}] {opt['source']}"
        source_color = Colors.GREEN if opt['priority'] == 1 else (Colors.CYAN if opt['priority'] == 2 else (Colors.YELLOW if opt['priority'] == 3 else Colors.BLUE))
        status_tag = f"{Colors.GREEN}[Installed]{Colors.RESET}" if opt.get('installed') else ""
        recommended = f" {Colors.BOLD}{Colors.GREEN}★ (Recommended){Colors.RESET}" if idx == 1 else ""
        
        name_display = opt['name'][:33]
        ver_display = opt.get('version', '')[:17]
        
        print(f"{Colors.BOLD}{idx:<3}{Colors.RESET} {source_color}{prio_tag:<24}{Colors.RESET} {Colors.BOLD}{name_display:<34}{Colors.RESET} {ver_display:<18} {status_tag}{recommended}")
        if opt.get('desc'):
            desc_text = opt['desc'][:88]
            votes_text = f" [Votes: {opt['votes']}]" if opt.get('votes') else ""
            print(f"    {Colors.DIM}{desc_text}{votes_text}{Colors.RESET}")

    print(f"{Colors.DIM}{'-'*98}{Colors.RESET}")
    print(f"\n{Colors.BOLD}Top Match: [1] ({all_options[0]['source']}: {all_options[0]['name']}){Colors.RESET}")
    print(f"Quick shortcuts: [b] Open Bauh GUI, [p] Open Pamac GUI, [s] Search again, [q] Exit\n")

    try:
        user_choice = input(f"{Colors.BOLD}Select option to install [Press Enter for 1]: {Colors.RESET}").strip().lower()
    except (KeyboardInterrupt, EOFError):
        return False

    if user_choice in ['', '1']:
        selected = all_options[0]
    elif user_choice == 'b':
        subprocess.Popen(['bauh'], start_new_session=True)
        return True
    elif user_choice == 'p':
        subprocess.Popen(['pamac-manager'], start_new_session=True)
        return True
    elif user_choice == 's':
        return True
    elif user_choice in ['q', '0', 'exit']:
        return False
    else:
        try:
            choice_idx = int(user_choice) - 1
            if 0 <= choice_idx < len(all_options):
                selected = all_options[choice_idx]
            else:
                print(f"{Colors.RED}Invalid selection.{Colors.RESET}")
                return True
        except ValueError:
            print(f"{Colors.RED}Invalid selection.{Colors.RESET}")
            return True

    print(f"\n{Colors.BOLD}{Colors.GREEN}[+] Installing '{selected['name']}' automatically via {selected['source']}...{Colors.RESET}")
    print(f"{Colors.DIM}Command: {' '.join(selected['install_cmd'])}{Colors.RESET}\n")

    if dry_run:
        print(f"{Colors.YELLOW}[Dry Run] Skipped command execution.{Colors.RESET}")
        return False
    
    install_success = False
    try:
        res = subprocess.run(selected['install_cmd'])
        if res.returncode == 0:
            install_success = True
        else:
            # Check if pacman / yay failed due to conflicting files or keyring
            if selected['priority'] in (1, 2, 4):
                print(f"\n{Colors.YELLOW}[!] Installation encountered an issue. Attempting automated recovery with --overwrite...{Colors.RESET}")
                recovery_cmd = list(selected['install_cmd'])
                if '--overwrite' not in recovery_cmd:
                    recovery_cmd.extend(['--overwrite', '*'])
                refresh_system_keyrings()
                retry_res = subprocess.run(recovery_cmd)
                if retry_res.returncode == 0:
                    install_success = True
        
        if install_success:
            notify("🐾 Purr: Installation Complete", f"Successfully installed {selected['name']}")
            trigger_tray_refresh()
            print(f"\n{Colors.BOLD}{Colors.GREEN}===================================================================================={Colors.RESET}")
            print(f"{Colors.BOLD}{Colors.GREEN}            [✔] '{selected['name']}' was installed successfully!                   {Colors.RESET}")
            print(f"{Colors.BOLD}{Colors.GREEN}===================================================================================={Colors.RESET}\n")
        else:
            print(f"\n{Colors.RED}[!] Package manager exited with status code {res.returncode}.{Colors.RESET}\n")
    except KeyboardInterrupt:
        print(f"\n{Colors.YELLOW}[!] Installation cancelled by user.{Colors.RESET}\n")
    except Exception as e:
        print(f"\n{Colors.RED}[!] Installation failed: {e}{Colors.RESET}\n")

    # Post-Install Interactive Prompt
    print(f"{Colors.BOLD}What would you like to do next?{Colors.RESET}")
    if install_success:
        print(f"  {Colors.BOLD}[l]{Colors.RESET} Launch '{selected['name']}' now")
    print(f"  {Colors.BOLD}[Enter / s]{Colors.RESET} Search & install another application")
    print(f"  {Colors.BOLD}[b]{Colors.RESET} Open Bauh GUI Store")
    print(f"  {Colors.BOLD}[p]{Colors.RESET} Open Pamac Software Center")
    print(f"  {Colors.BOLD}[q]{Colors.RESET} Exit")

    try:
        next_action = input(f"\n{Colors.BOLD}Select next action [Default: Search]: {Colors.RESET}").strip().lower()
    except (KeyboardInterrupt, EOFError):
        return False

    if next_action == 'l' and install_success:
        launch_installed_app(selected)
        time.sleep(1)
        return True
    elif next_action == 'b':
        subprocess.Popen(['bauh'], start_new_session=True)
        return True
    elif next_action == 'p':
        subprocess.Popen(['pamac-manager'], start_new_session=True)
        return True
    elif next_action in ['q', 'exit']:
        return False
    else:
        return True

def check_and_clean_pacman_lock():
    lock_file = "/var/lib/pacman/db.lck"
    if os.path.exists(lock_file):
        proc1 = subprocess.run(['pgrep', '-x', 'pacman'], capture_output=True, text=True)
        proc2 = subprocess.run(['pgrep', '-x', 'yay'], capture_output=True, text=True)
        if proc1.returncode != 0 and proc2.returncode != 0:
            print(f"{Colors.YELLOW}[!] Found stale database lock ({lock_file}) with no active package manager. Safely cleaning...{Colors.RESET}")
            subprocess.run(['sudo', 'rm', '-f', lock_file], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def refresh_system_keyrings():
    print(f"{Colors.CYAN}[*] Auto-recovering system keyrings to resolve package signature trust issues...{Colors.RESET}")
    keyring_pkgs = ['archlinux-keyring']
    
    # Check archlinuxcn
    res_cn = subprocess.run(['pacman', '-Qq', 'archlinuxcn-keyring'], capture_output=True, text=True)
    if res_cn.returncode == 0 or os.path.exists('/etc/pacman.d/archlinuxcn-mirrorlist'):
        keyring_pkgs.append('archlinuxcn-keyring')
        
    # Check endeavouros
    res_eos = subprocess.run(['pacman', '-Qq', 'endeavouros-keyring'], capture_output=True, text=True)
    if res_eos.returncode == 0:
        keyring_pkgs.append('endeavouros-keyring')
        
    cmd = ['sudo', 'pacman', '-Sy', '--needed', '--noconfirm'] + keyring_pkgs
    subprocess.run(cmd)

def run_pacman_upgrade_with_auto_conflict_resolution():
    check_and_clean_pacman_lock()
    print(f"{Colors.BOLD}{Colors.GREEN}[1/3] Upgrading Official System Repositories (pacman)...{Colors.RESET}")
    
    cmd = ['sudo', 'pacman', '-Syu', '--noconfirm', '--ask', '4']
    res = subprocess.run(cmd)
    
    if res.returncode == 0:
        return True

    # If failed, attempt automated diagnosis & recovery
    print(f"\n{Colors.YELLOW}[!] Pacman upgrade encountered an issue (exit code {res.returncode}). Attempting automated diagnosis & recovery...{Colors.RESET}")
    
    diag_res = subprocess.run(cmd, capture_output=True, text=True)
    combined_output = (diag_res.stdout or '') + '\n' + (diag_res.stderr or '')
    
    # 1. Keyring / Signature / Trust recovery
    if any(phrase in combined_output.lower() for phrase in ['invalid or corrupted package', 'unknown trust', 'signature from', 'key could not be looked up remotely', 'corrupted database']):
        print(f"{Colors.CYAN}[*] Diagnosed: Package signature trust / keyring issue.{Colors.RESET}")
        refresh_system_keyrings()
        retry_res = subprocess.run(cmd)
        if retry_res.returncode == 0:
            return True

    # 2. Conflicting Files in filesystem recovery
    if 'conflicting files' in combined_output.lower() or 'exists in filesystem' in combined_output.lower():
        print(f"{Colors.CYAN}[*] Diagnosed: Conflicting untracked files in filesystem.{Colors.RESET}")
        print(f"{Colors.CYAN}[*] Safely auto-resolving filesystem conflicts via pacman --overwrite...{Colors.RESET}")
        retry_res = subprocess.run(['sudo', 'pacman', '-Syu', '--noconfirm', '--ask', '4', '--overwrite', '*'])
        if retry_res.returncode == 0:
            return True

    print(f"{Colors.RED}[!] Could not automatically resolve all pacman conflicts.{Colors.RESET}")
    return False

def run_yay_upgrade():
    print(f"\n{Colors.BOLD}{Colors.CYAN}[2/3] Upgrading Arch User Repository (AUR / yay)...{Colors.RESET}")
    check_and_clean_pacman_lock()
    base_cmd = [
        'yay', '-Sua', '--noconfirm',
        '--answerclean', 'All', '--answerdiff', 'None',
        '--answeredit', 'None', '--answerupgrade', 'None',
        '--overwrite', '*', '--removemake', '--cleanafter'
    ]
    res = subprocess.run(base_cmd)
    if res.returncode == 0:
        return True

    print(f"\n{Colors.YELLOW}[!] AUR upgrade encountered an issue (exit code {res.returncode}). Attempting automated diagnosis & recovery...{Colors.RESET}")
    
    # 1. Refresh keyrings in case dependency signatures failed
    refresh_system_keyrings()
    
    # 2. Retry with full rebuild & cleanbuild & overwrite
    retry_cmd = [
        'yay', '-Sua', '--noconfirm', '--rebuild',
        '--answerclean', 'All', '--answerdiff', 'None',
        '--answeredit', 'None', '--answerupgrade', 'None',
        '--overwrite', '*', '--removemake', '--cleanafter'
    ]
    retry_res = subprocess.run(retry_cmd)
    if retry_res.returncode != 0:
        print(f"{Colors.YELLOW}[!] AUR upgrade exited with code {retry_res.returncode}{Colors.RESET}")
    return retry_res.returncode == 0

def run_flatpak_upgrade_and_cleanup():
    print(f"\n{Colors.BOLD}{Colors.YELLOW}[3/3] Upgrading Flatpak Applications & Pruning Unsupported / EOL Runtimes...{Colors.RESET}")
    # 1. Update Flatpak applications & runtimes
    subprocess.run(['flatpak', 'update', '-y', '--noninteractive'])
    
    # 2. Auto-uninstall unsupported and EOL runtimes
    print(f"{Colors.DIM}--> Auto-pruning unsupported, unreferenced & EOL Flatpak runtimes...{Colors.RESET}")
    res_clean = subprocess.run(['flatpak', 'uninstall', '--unused', '-y', '--noninteractive'], capture_output=True, text=True)
    if res_clean.returncode == 0 and res_clean.stdout.strip():
        lines = [l for l in res_clean.stdout.strip().split('\n') if l.strip().startswith('Uninstalling')]
        if lines:
            print(f"{Colors.GREEN}[✔] Cleaned up {len(lines)} obsolete / EOL Flatpak runtime(s).{Colors.RESET}")
        else:
            print(f"{Colors.GREEN}[✔] Flatpak runtimes are clean and up to date.{Colors.RESET}")
    else:
        print(f"{Colors.GREEN}[✔] Flatpak runtimes are clean and up to date.{Colors.RESET}")

def trigger_tray_refresh():
    """Notifies running purr-tray instance to immediately refresh update status and tray icon badge."""
    trigger_file = os.path.expanduser("~/.cache/purr/refresh_trigger")
    try:
        os.makedirs(os.path.dirname(trigger_file), exist_ok=True)
        with open(trigger_file, "w") as f:
            f.write(str(time.time()))
    except Exception:
        pass
    try:
        subprocess.run(['pkill', '-USR1', '-f', 'purr-tray'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def run_system_upgrade():
    print_banner()
    print(f"{Colors.BOLD}{Colors.CYAN}🐾 Purr Universal System Upgrade (Project Tuki){Colors.RESET}")
    print(f"{Colors.DIM}Sequentially upgrading System Repositories, AUR, and Flatpaks with auto-conflict resolution...{Colors.RESET}\n")

    start_time = time.time()

    # Step 1: Official Pacman Repositories with Auto Conflict Resolution
    run_pacman_upgrade_with_auto_conflict_resolution()

    # Step 2: AUR via yay
    run_yay_upgrade()

    # Step 3: Flatpak & EOL Runtime Pruning
    run_flatpak_upgrade_and_cleanup()

    elapsed = round(time.time() - start_time, 1)
    print(f"\n{Colors.BOLD}{Colors.GREEN}===================================================================================={Colors.RESET}")
    print(f"{Colors.BOLD}{Colors.GREEN}       [✔] Universal System Upgrade Complete in {elapsed}s! System is Up to Date.      {Colors.RESET}")
    print(f"{Colors.BOLD}{Colors.GREEN}===================================================================================={Colors.RESET}\n")

    notify("🐾 System Upgrade Complete", f"All packages upgraded and EOL runtimes pruned in {elapsed}s.")

    # Instantly notify purr-tray daemon to refresh icon badge
    trigger_tray_refresh()

    # Refresh desktop caches
    try:
        subprocess.run(['kbuildsycoca6', '--noincremental'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    print(f"{Colors.BOLD}Next action:{Colors.RESET}")
    print(f"  {Colors.BOLD}[s]{Colors.RESET} Search & install an application")
    print(f"  {Colors.BOLD}[Enter / q]{Colors.RESET} Exit")
    try:
        ans = input(f"\nSelect action [Default: Exit]: ").strip().lower()
        if ans in ['s', 'search']:
            return run_search_and_install()
    except (KeyboardInterrupt, EOFError):
        pass
    return

def _get_recipe_manager():
    _repo_root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    if _repo_root not in sys.path:
        sys.path.insert(0, _repo_root)
    for p in ['/usr/share/purr', '/usr/local/share/purr']:
        if p not in sys.path:
            sys.path.insert(0, p)
    try:
        from recipes.manager import RecipeManager
        return RecipeManager()
    except Exception as e:
        print(f"{Colors.RED}[!] Could not load Purr Recipe Manager: {e}{Colors.RESET}")
        return None

def run_recipe_command(subargs):
    print_banner()
    mgr = _get_recipe_manager()
    if not mgr:
        sys.exit(1)

    cmd = subargs[0] if subargs else "list"
    target_id = subargs[1] if len(subargs) > 1 else None

    if cmd in ["-h", "--help", "help"]:
        print(f"{Colors.BOLD}{Colors.CYAN}🐾 purr recipe — Ecosystem Recipe Manager{Colors.RESET}\n")
        print(f"  {Colors.BOLD}Commands:{Colors.RESET}")
        print(f"    purr recipe list                      List all registered recipes and status")
        print(f"    purr recipe info <id>                 Show detailed architecture, packages, and notes")
        print(f"    purr recipe apply <id>                Provision and configure complete recipe ecosystem")
        print(f"    purr recipe doctor <id>               Run diagnostic health checks on installed recipe")
        print(f"    purr recipe prune <id>                Clean stale build artifacts and runtime caches")
        print(f"    purr recipe teardown <id>             Cleanly remove installed recipe and restore defaults\n")
        return

    if cmd in ["list", "ls"]:
        recipes = mgr.list_recipes()
        print(f"{Colors.BOLD}{Colors.CYAN}🐾 Purr Ecosystem Recipes ({len(recipes)} available){Colors.RESET}")
        print(f"{Colors.DIM}Curated, reproducible application environments and system integrations.{Colors.RESET}\n")
        
        for r in recipes:
            info = r.get_info()
            print(f"  {Colors.BOLD}{Colors.GREEN}{info['id']:<20}{Colors.RESET} {Colors.BOLD}{info['name']}{Colors.RESET} (v{info['version']})")
            print(f"  {Colors.DIM}Category: {info['category']} | Tags: {', '.join(info['tags'])}{Colors.RESET}")
            print(f"  {info['description']}\n")

        print(f"{Colors.BOLD}Usage:{Colors.RESET}")
        print(f"  purr recipe info <id>      View recipe details & hardware requirements")
        print(f"  purr recipe apply <id>     Provision and integrate recipe")
        print(f"  purr recipe doctor <id>    Run subsystem health diagnostics")
        print(f"  purr recipe prune <id>     Safely clean containers and caches\n")
        return

    if cmd in ["info", "show"]:
        if not target_id:
            print(f"{Colors.RED}[!] Please specify a recipe ID (e.g. 'purr recipe info waydroid-native').{Colors.RESET}")
            sys.exit(1)
        r = mgr.get_recipe(target_id)
        if not r:
            print(f"{Colors.RED}[!] Recipe '{target_id}' not found.{Colors.RESET}")
            sys.exit(1)
        info = r.get_info()
        print(f"{Colors.BOLD}{Colors.CYAN}🐾 Recipe Info: {info['name']}{Colors.RESET}")
        print(f"  {Colors.BOLD}ID:{Colors.RESET}          {info['id']}")
        print(f"  {Colors.BOLD}Version:{Colors.RESET}     {info['version']}")
        print(f"  {Colors.BOLD}Author:{Colors.RESET}      {info['author']}")
        print(f"  {Colors.BOLD}Category:{Colors.RESET}    {info['category']}")
        print(f"  {Colors.BOLD}Tags:{Colors.RESET}        {', '.join(info['tags'])}")
        print(f"\n  {Colors.BOLD}Description:{Colors.RESET}\n  {info['description']}\n")
        
        pre = r.check_prerequisites()
        print(f"  {Colors.BOLD}Prerequisites Check:{Colors.RESET} {'[✔] Satisfied' if pre.success else '[✖] Incomplete'}")
        if not pre.success:
            print(f"  {Colors.YELLOW}{pre.message}{Colors.RESET}")
        print()
        return

    if cmd in ["apply", "install"]:
        if not target_id:
            print(f"{Colors.RED}[!] Please specify a recipe ID (e.g. 'purr recipe apply waydroid-native').{Colors.RESET}")
            sys.exit(1)
        print(f"{Colors.BOLD}{Colors.GREEN}🐾 Applying Purr Recipe: {target_id}...{Colors.RESET}\n")
        res = mgr.apply(target_id)
        if res.success:
            print(f"\n{Colors.BOLD}{Colors.GREEN}===================================================================================={Colors.RESET}")
            print(f"{Colors.BOLD}{Colors.GREEN}       [✔] Recipe '{target_id}' applied and integrated successfully!                {Colors.RESET}")
            print(f"{Colors.BOLD}{Colors.GREEN}===================================================================================={Colors.RESET}\n")
        else:
            print(f"\n{Colors.BOLD}{Colors.RED}[✖] Recipe application failed: {res.message}{Colors.RESET}\n")
            sys.exit(1)
        return

    if cmd in ["doctor", "check", "test"]:
        if not target_id:
            print(f"{Colors.RED}[!] Please specify a recipe ID (e.g. 'purr recipe doctor waydroid-native').{Colors.RESET}")
            sys.exit(1)
        print(f"{Colors.BOLD}{Colors.CYAN}🐾 Running Diagnostic Health Check for: {target_id}...{Colors.RESET}\n")
        res = mgr.doctor(target_id)
        print(f"{Colors.BOLD}Health Status:{Colors.RESET} {'[✔] HEALTHY' if res.success else '[!] WARNINGS DETECTED'}")
        print(f"{Colors.DIM}{res.message}{Colors.RESET}\n")
        if res.data:
            print(f"{Colors.BOLD}Component Diagnostics:{Colors.RESET}")
            for k, v in res.data.items():
                print(f"  • {Colors.BOLD}{k:<25}{Colors.RESET} : {v}")
        print()
        return

    if cmd in ["prune", "clean"]:
        if not target_id:
            print(f"{Colors.RED}[!] Please specify a recipe ID (e.g. 'purr recipe prune waydroid-native').{Colors.RESET}")
            sys.exit(1)
        print(f"{Colors.BOLD}{Colors.YELLOW}🐾 Pruning Recipe State: {target_id}...{Colors.RESET}")
        res = mgr.prune(target_id)
        if res.success:
            print(f"{Colors.GREEN}[✔] {res.message}{Colors.RESET}\n")
        else:
            print(f"{Colors.RED}[!] {res.message}{Colors.RESET}\n")
            sys.exit(1)
        return

    if cmd in ["teardown", "uninstall", "remove"]:
        if not target_id:
            print(f"{Colors.RED}[!] Please specify a recipe ID (e.g. 'purr recipe teardown waydroid-native').{Colors.RESET}")
            sys.exit(1)
        print(f"{Colors.BOLD}{Colors.RED}🐾 Tearing Down Recipe: {target_id}...{Colors.RESET}")
        res = mgr.teardown(target_id)
        if res.success:
            print(f"{Colors.GREEN}[✔] {res.message}{Colors.RESET}\n")
        else:
            print(f"{Colors.RED}[!] {res.message}{Colors.RESET}\n")
            sys.exit(1)
        return

    print(f"{Colors.RED}[!] Unknown recipe command '{cmd}'. Try 'purr recipe list'.{Colors.RESET}")
    sys.exit(1)

def _is_waydroid_configured():
    cfg_path = "/var/lib/waydroid/waydroid.cfg"
    sys_img = "/var/lib/waydroid/images/system.img"
    return os.path.exists(cfg_path) and os.path.exists(sys_img)

def run_apk_command(subargs):
    print_banner()
    if not _is_waydroid_configured():
        print(f"{Colors.BOLD}{Colors.YELLOW}🐾 [!] Android Subsystem (Waydroid) is not configured yet.{Colors.RESET}\n")
        print(f"  The 'purr apk' command requires the Android ecosystem to be provisioned first.")
        print(f"  To provision Waydroid with multi-window freeform mode and ARM translation, run:\n")
        print(f"    {Colors.BOLD}{Colors.GREEN}purr recipe apply waydroid-native{Colors.RESET}\n")
        sys.exit(1)

    mgr = _get_recipe_manager()
    if not mgr:
        sys.exit(1)
    
    r = mgr.get_recipe("waydroid-native")
    if not r:
        print(f"{Colors.RED}[!] Waydroid Native Recipe is not registered.{Colors.RESET}")
        sys.exit(1)

    cmd = subargs[0] if subargs else "list"

    if cmd in ["-h", "--help", "help"]:
        print(f"{Colors.BOLD}{Colors.CYAN}🐾 purr apk — Android Application Subsystem Management{Colors.RESET}\n")
        print(f"  {Colors.BOLD}Commands:{Colors.RESET}")
        print(f"    purr apk list                         List all installed Android applications")
        print(f"    purr apk install <app.apk>            Install an Android APK into Waydroid")
        print(f"    purr apk launch <package_name>        Launch an Android application with saved geometry restore")
        print(f"    purr apk sync                         Sync all Android applications to KDE Plasma Kickoff")
        print(f"    purr apk certify                      Display Android GSF Device ID for Google Play Protect")
        print(f"    purr apk session [start|stop|restart|mode] Manage Waydroid session & switch modes")
        print(f"    purr apk ui                           Show full Android subsystem UI window\n")
        return

    if cmd in ["install", "-i"]:
        if len(subargs) < 2:
            print(f"{Colors.RED}[!] Please specify path to APK file: purr apk install <path-to-file.apk>{Colors.RESET}")
            sys.exit(1)
        apk_path = subargs[1]
        print(f"{Colors.BOLD}{Colors.CYAN}🐾 Installing Android Package: {apk_path}...{Colors.RESET}")
        ok, msg = r.install_apk(apk_path)
        if ok:
            print(f"{Colors.GREEN}[✔] {msg}{Colors.RESET}")
        else:
            print(f"{Colors.RED}[!] {msg}{Colors.RESET}")
            sys.exit(1)
        return

    if cmd in ["launch", "open", "run"]:
        if len(subargs) < 2:
            print(f"{Colors.RED}[!] Please specify package name: purr apk launch <package-name>{Colors.RESET}")
            sys.exit(1)
        pkg_name = subargs[1]
        print(f"{Colors.BOLD}{Colors.GREEN}🐾 Launching Android Application: {pkg_name}...{Colors.RESET}")
        ok, msg = r.launch_app(pkg_name)
        if ok:
            print(f"{Colors.GREEN}[✔] {msg}{Colors.RESET}")
            # Restore saved window geometry if present
            try:
                import threading
                from recipes.waydroid_native.window_memory import restore_app_bounds
                t = threading.Thread(target=restore_app_bounds, args=(pkg_name, 10, 0.25), daemon=True)
                t.start()
                t.join(timeout=2.5)
            except Exception:
                pass
        else:
            print(f"{Colors.RED}[!] {msg}{Colors.RESET}")
            sys.exit(1)
        return

    if cmd in ["list", "ls", "apps"]:
        print(f"{Colors.BOLD}{Colors.CYAN}🐾 Installed Android Applications in Waydroid:{Colors.RESET}\n")
        apps = r.list_apps()
        if not apps:
            print(f"  {Colors.DIM}(No installed Android applications found or session not running){Colors.RESET}\n")
        else:
            for a in apps:
                print(f"  • {Colors.BOLD}{a['name']:<25}{Colors.RESET} ({a['package']})")
            print()
        return

    if cmd in ["certify", "id", "play"]:
        print(f"{Colors.BOLD}{Colors.CYAN}🐾 Google Play Store Device Certification Helper{Colors.RESET}\n")
        dev_id = r.get_android_id()
        if dev_id:
            print(f"  {Colors.BOLD}Android GSF Device ID:{Colors.RESET} {Colors.GREEN}{dev_id}{Colors.RESET}")
            print(f"\n  To register this uncertified device with Google Play Protect:")
            print(f"  {Colors.UNDERLINE}https://www.google.com/android/uncertified/{Colors.RESET}")
            print(f"\n  Paste the Device ID above into the registration page and click 'Register'.\n")
        else:
            print(f"  {Colors.YELLOW}[!] Android ID not found yet. Make sure Waydroid session has booted at least once with GAPPS.{Colors.RESET}\n")
        return

    if cmd in ["session"]:
        action = subargs[1] if len(subargs) > 1 else "start"
        waydroid_bin = shutil.which("waydroid") or "/usr/bin/waydroid"
        if action == "start":
            print(f"{Colors.GREEN}🐾 Starting Waydroid session...{Colors.RESET}")
            subprocess.run([waydroid_bin, "session", "start"])
        elif action == "stop":
            print(f"{Colors.YELLOW}🐾 Stopping Waydroid session...{Colors.RESET}")
            subprocess.run(["sudo", "/usr/bin/python3", "/usr/lib/waydroid/waydroid.py", "session", "stop"])
        elif action == "restart":
            print(f"{Colors.CYAN}🐾 Restarting Waydroid container and session...{Colors.RESET}")
            subprocess.run(["sudo", "systemctl", "restart", "waydroid-container.service"])
        elif action in ["mode", "switch-mode", "toggle-mode"]:
            target_mode = subargs[2] if len(subargs) > 2 else None
            try:
                from recipes.waydroid_native.system_tuning import get_waydroid_prop, set_waydroid_prop
                current = get_waydroid_prop("persist.waydroid.multi_windows", "true")
                if not target_mode:
                    is_multi = current.lower() == "true"
                    new_multi = "false" if is_multi else "true"
                elif target_mode.lower() in ["multi", "multi-window", "floating", "windowed", "true"]:
                    new_multi = "true"
                else:
                    new_multi = "false"

                mode_name = "Multi-Window Freeform (Floating Apps)" if new_multi == "true" else "Full Subsystem Tablet UI (Fullscreen/Gaming)"
                print(f"{Colors.BOLD}{Colors.CYAN}🐾 Switching Android Subsystem Mode to: {mode_name}...{Colors.RESET}")
                set_waydroid_prop("persist.waydroid.multi_windows", new_multi)

                subprocess.run(["sudo", "/usr/bin/python3", "/usr/lib/waydroid/waydroid.py", "session", "stop"], capture_output=True)
                subprocess.run(["systemctl", "--user", "restart", "waydroid-session.service"], capture_output=True)
                time.sleep(1.5)
                if new_multi == "false":
                    subprocess.Popen([waydroid_bin, "show-full-ui"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                print(f"{Colors.GREEN}[✔] Switched successfully to {mode_name}.{Colors.RESET}")
            except Exception as e:
                print(f"{Colors.RED}[!] Failed to switch mode: {e}{Colors.RESET}")
        return

    if cmd in ["sync", "refresh", "desktop"]:
        print(f"{Colors.BOLD}{Colors.CYAN}🐾 Syncing Android Application Launchers to KDE Plasma Kickoff...{Colors.RESET}")
        try:
            from recipes.waydroid_native.desktop_sync import sync_android_desktop_entries
            ok, entries = sync_android_desktop_entries()
            print(f"{Colors.GREEN}[✔] Generated {len(entries)} desktop launchers in Kickoff & Application Menu.{Colors.RESET}")
        except Exception as e:
            print(f"{Colors.RED}[!] Failed to sync desktop entries: {e}{Colors.RESET}")
        return

    if cmd in ["ui", "show-ui", "launcher"]:
        print(f"{Colors.BOLD}{Colors.GREEN}🐾 Launching Waydroid Android Subsystem UI...{Colors.RESET}")
        waydroid_bin = shutil.which("waydroid") or "/usr/bin/waydroid"
        subprocess.Popen([waydroid_bin, "show-full-ui"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return

    if cmd in ["paste", "type", "clip"]:
        text = subargs[1] if len(subargs) > 1 else None
        if not text:
            try:
                import pyclip
                raw = pyclip.paste()
                if isinstance(raw, bytes):
                    text = raw.decode("utf-8", errors="replace")
                else:
                    text = str(raw) if raw else ""
            except Exception:
                try:
                    text = subprocess.run(["wl-paste", "--no-newline"], capture_output=True, text=True).stdout
                except Exception:
                    text = ""

        if not text:
            print(f"{Colors.YELLOW}[!] Host clipboard is empty.{Colors.RESET}")
            return

        import shlex
        # 1. Sync directly to Android's primary system clipboard via PurrClipHelper
        try:
            clip_cmd = f"PATH=/system/bin:/system/xbin am broadcast -a dev.purr.cliphelper.SET_CLIP -n dev.purr.cliphelper/.ClipReceiver -f 0x10000000 --es text {shlex.quote(text)}"
            subprocess.run(["sudo", "lxc-attach", "-P", "/var/lib/waydroid/lxc", "-n", "waydroid", "--", "/system/bin/sh", "-c", clip_cmd],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
        except Exception:
            pass

        # 2. Trigger native PASTE keyevent into active focused field
        cmd_str = "PATH=/system/bin:/system/xbin input keyevent 279"
        res = subprocess.run(["sudo", "lxc-attach", "-P", "/var/lib/waydroid/lxc", "-n", "waydroid", "--", "/system/bin/sh", "-c", cmd_str], capture_output=True)
        if res.returncode == 0:
            print(f"{Colors.GREEN}[✔] Synchronized clipboard and dispatched paste into Android.{Colors.RESET}")
        else:
            print(f"{Colors.RED}[!] Failed to paste: {res.stderr.decode('utf-8', errors='replace').strip()}{Colors.RESET}")
        return

    print(f"{Colors.RED}[!] Unknown apk command '{cmd}'. Try 'purr apk list' or 'purr apk install <app.apk>'.{Colors.RESET}")
    sys.exit(1)

def main():
    if len(sys.argv) > 1 and sys.argv[1] in ['upgrade', 'update', 'up']:
        run_system_upgrade()
        sys.exit(0)

    if len(sys.argv) > 1 and sys.argv[1] in ['recipe', 'recipes']:
        run_recipe_command(sys.argv[2:])
        sys.exit(0)

    if len(sys.argv) > 1 and sys.argv[1] in ['apk', 'android']:
        run_apk_command(sys.argv[2:])
        sys.exit(0)

    if len(sys.argv) > 1 and sys.argv[1] == 'tray':
        script_dir = os.path.dirname(os.path.realpath(__file__))
        tray_script = os.path.join(script_dir, 'purr-tray')
        if not os.path.exists(tray_script):
            tray_script = shutil.which('purr-tray') or '/usr/local/bin/purr-tray'
        
        python_bin = '/usr/bin/python3' if os.path.exists('/usr/bin/python3') else sys.executable
        forward_args = [a for a in sys.argv[2:] if a not in ['--daemon', '-d']]
        if '--daemon' in sys.argv or '-d' in sys.argv:
            subprocess.Popen([python_bin, tray_script] + forward_args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)
            print(f"{Colors.GREEN}🐾 Purr System Tray Indicator started in background.{Colors.RESET}")
            sys.exit(0)
        else:
            os.execv(python_bin, [python_bin, tray_script] + sys.argv[2:])

    if len(sys.argv) > 1 and sys.argv[1] in ['integrate', 'kde']:
        script_dir = os.path.dirname(os.path.realpath(__file__))
        integ_script = os.path.join(script_dir, 'purr-integrate')
        if not os.path.exists(integ_script):
            integ_script = shutil.which('purr-integrate') or '/usr/local/bin/purr-integrate'
        python_bin = '/usr/bin/python3' if os.path.exists('/usr/bin/python3') else sys.executable
        os.execv(python_bin, [python_bin, integ_script] + sys.argv[2:])

    parser = argparse.ArgumentParser(
        prog="purr",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="🐾 purr (Project Tuki) — Universal Application Discovery and Priority Installer for Arch Linux & KDE Plasma.",
        epilog="""Commands & Shortcuts:
  purr [query...]               Search, rank, and install application across Pacman, AUR, Flatpak, and AppImage
  purr upgrade | up | update    Run universal system upgrade with auto-conflict resolution and Flatpak EOL pruning
  purr recipe [list|apply|...]  Manage and apply ecosystem recipes (e.g. 'purr recipe apply waydroid-native')
  purr apk [install|launch|...] Manage Android apps and subsystems (e.g. 'purr apk install app.apk')
  purr tray [--daemon] [-i MIN] Launch system tray indicator & background update monitor
  purr integrate [--all]        Manage native KDE Plasma desktop integrations (pinning, favorites, autostart)

Examples:
  purr "google chrome"          Discover and install Google Chrome
  purr recipe list              List all available reproducible ecosystem recipes
  purr recipe apply waydroid-native  Turnkey Android multi-window + libndk runtime
  purr apk install app.apk      Directly install Android APK into Waydroid
  purr apk paste [text]         Inject host clipboard into active Android input field
  purr apk certify              Get Google Play Protect registration Device ID
  purr upgrade                  Perform universal system upgrade
  purr tray --daemon -i 30      Start tray indicator in background checking every 30 mins
  purr integrate --status       Inspect KDE Plasma desktop integration status
"""
    )
    parser.add_argument("query", nargs="*", help="Application name or search keyword (e.g. 'google chrome', 'vscode', 'spotify')")
    parser.add_argument("-v", "--version", action="version", version=f"%(prog)s {__version__} (Project Tuki)")
    parser.add_argument("--dry-run", action="store_true", help="Search and resolve without executing installation")
    parser.add_argument("--no-loop", action="store_true", help="Exit immediately after single installation without session loop")
    
    args = parser.parse_args()

    initial_query = " ".join(args.query).strip() if args.query else None
    
    keep_running = True
    first_run = True
    
    while keep_running:
        q = initial_query if first_run and initial_query else None
        first_run = False
        initial_query = None
        
        try:
            keep_running = run_search_and_install(q, dry_run=args.dry_run)
            if args.no_loop or args.dry_run:
                break
            if keep_running:
                print("\n" * 2)
        except (KeyboardInterrupt, EOFError):
            break

    print(f"\n{Colors.CYAN}🐾 Thank you for using purr. Making your Arch system purr peacefully! Goodbye!{Colors.RESET}")
    time.sleep(0.3)

if __name__ == '__main__':
    main()
