#!/usr/bin/python3
"""
🐾 Purr System Tray Indicator (Project Tuki)
Native KDE Plasma System Tray integration with Color-Coded Urgency Signals & Universal System Upgrade.

Urgency Signal Color Hierarchy:
- Clean (0 updates): Base calm Tuki emblem
- Low (1-5 minor updates): Cyan (#00BCD4)
- Medium (6-20 updates): Amber (#FF9800)
- High / Critical (>20 updates or core system packages): Crimson Coral (#E53935)
"""

import sys
import os
import subprocess
import shutil
import signal
import json
import argparse
import threading

try:
    from PyQt6.QtWidgets import (
        QApplication, QSystemTrayIcon, QMenu, QMessageBox, QInputDialog, QLineEdit
    )
    from PyQt6.QtGui import QIcon, QAction, QPixmap, QPainter, QColor, QBrush, QPen
    from PyQt6.QtCore import QTimer, QRunnable, QThreadPool, QObject, pyqtSignal, pyqtSlot, Qt, QRect, QFileSystemWatcher
except ImportError as e:
    print(f"🐾 [Purr Tray Error] Required dependency 'python-pyqt6' is not installed: {e}", file=sys.stderr)
    print("   Please install it using: sudo pacman -S python-pyqt6", file=sys.stderr)
    sys.exit(1)

APP_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if APP_DIR not in sys.path:
    sys.path.insert(0, APP_DIR)

CONFIG_DIR = os.path.expanduser("~/.config/purr")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")
DEFAULT_INTERVAL_MINUTES = 60
DEFAULT_INITIAL_DELAY_SECONDS = 15
BACKOFF_RETRY_SECONDS = 120

def is_waydroid_configured():
    """
    Checks if the waydroid-native recipe has been provisioned and configured on the host.
    """
    return os.path.exists("/var/lib/waydroid/waydroid.cfg") and os.path.exists("/var/lib/waydroid/images/system.img")

def load_config():
    config = {
        "update_interval_minutes": DEFAULT_INTERVAL_MINUTES,
        "initial_delay_seconds": DEFAULT_INITIAL_DELAY_SECONDS
    }
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                if isinstance(data, dict):
                    config.update(data)
        except Exception:
            pass
    return config

def save_config(config):
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(config, f, indent=2)
    except Exception:
        pass

ICON_PATHS = [
    os.path.join(APP_DIR, "data", "icons", "purr.svg"),
    os.path.expanduser("~/.local/share/icons/hicolor/scalable/apps/purr.svg"),
    "/usr/share/icons/hicolor/scalable/apps/purr.svg",
    "/usr/local/share/icons/hicolor/scalable/apps/purr.svg"
]

CRITICAL_SYSTEM_PACKAGES = {
    'linux', 'linux-lts', 'linux-zen', 'linux-hardened', 'systemd', 'systemd-libs',
    'glibc', 'openssl', 'lib32-openssl', 'sudo', 'polkit', 'kwin', 'plasma-desktop',
    'qt6-base', 'mesa', 'nvidia', 'cryptsetup', 'dbus', 'wayland', 'pipewire'
}

class UrgencyLevel:
    NONE = "none"
    LOW = "low"         # Cyan
    MEDIUM = "medium"   # Amber
    HIGH = "high"       # Crimson Coral

class WorkerSignals(QObject):
    finished = pyqtSignal(int, str, dict, str, list, bool, int)

class UpdateCheckerRunnable(QRunnable):
    def __init__(self):
        super().__init__()
        self.signals = WorkerSignals()

    @pyqtSlot()
    def run(self):
        count = 0
        breakdown = {"pacman": 0, "aur": 0, "flatpak": 0}
        details = []
        critical_found = []
        all_pkg_names = []
        is_network_error = False
        unused_flatpaks = 0

        try:
            # Check pacman updates
            res = subprocess.run(['checkupdates'], capture_output=True, text=True, timeout=15)
            if res.returncode == 0 and res.stdout.strip():
                lines = [l for l in res.stdout.strip().split('\n') if l]
                breakdown["pacman"] = len(lines)
                count += len(lines)
                details.append(f"{len(lines)} Official")
                for line in lines:
                    pkg_name = line.split()[0].strip() if line.split() else ""
                    all_pkg_names.append(pkg_name)
                    if pkg_name in CRITICAL_SYSTEM_PACKAGES:
                        critical_found.append(pkg_name)
            elif res.returncode not in (0, 2):
                if "could not resolve host" in (res.stderr or "").lower() or "failed to connect" in (res.stderr or "").lower():
                    is_network_error = True
        except Exception:
            is_network_error = True

        try:
            # Check AUR updates via yay
            res = subprocess.run(['yay', '-Qua'], capture_output=True, text=True, timeout=15)
            if res.returncode == 0 and res.stdout.strip():
                lines = [l for l in res.stdout.strip().split('\n') if l]
                breakdown["aur"] = len(lines)
                count += len(lines)
                details.append(f"{len(lines)} AUR")
                for line in lines:
                    pkg_name = line.split()[0].strip() if line.split() else ""
                    all_pkg_names.append(pkg_name)
                    if pkg_name in CRITICAL_SYSTEM_PACKAGES:
                        critical_found.append(pkg_name)
            elif res.returncode != 0:
                if "could not resolve host" in (res.stderr or "").lower() or "failed to connect" in (res.stderr or "").lower():
                    is_network_error = True
        except Exception:
            pass

        try:
            # Check flatpak updates
            res = subprocess.run(['flatpak', 'remote-ls', '--updates'], capture_output=True, text=True, timeout=12)
            if res.returncode == 0 and res.stdout.strip():
                lines = [l for l in res.stdout.strip().split('\n') if l]
                breakdown["flatpak"] = len(lines)
                count += len(lines)
                details.append(f"{len(lines)} Flatpak")
        except Exception:
            pass

        try:
            # Check for unreferenced/EOL Flatpak runtimes
            res = subprocess.run(['flatpak', 'uninstall', '--unused', '--dry-run'], capture_output=True, text=True, timeout=8)
            if res.returncode == 0 and res.stdout.strip():
                unused_lines = [l for l in res.stdout.strip().split('\n') if l.strip().startswith('Uninstalling')]
                unused_flatpaks = len(unused_lines)
        except Exception:
            pass

        # Evaluate Urgency Level
        if count == 0:
            urgency = UrgencyLevel.NONE
        elif len(critical_found) > 0 or count > 20:
            urgency = UrgencyLevel.HIGH
        elif count > 5:
            urgency = UrgencyLevel.MEDIUM
        else:
            urgency = UrgencyLevel.LOW

        summary = " • ".join(details) if details else "System is up to date."
        self.signals.finished.emit(count, summary, breakdown, urgency, critical_found, is_network_error, unused_flatpaks)

class PurrTrayApp:
    def __init__(self, interval_minutes=None, initial_delay_seconds=None):
        self.app = QApplication(sys.argv)
        self.app.setQuitOnLastWindowClosed(False)
        self.app.setApplicationName("Purr")
        self.app.setDesktopFileName("purr")

        # Load configuration & apply defaults
        self.config = load_config()
        if interval_minutes is not None:
            self.config["update_interval_minutes"] = max(5, int(interval_minutes))
        if initial_delay_seconds is not None:
            self.config["initial_delay_seconds"] = max(2, int(initial_delay_seconds))

        self.interval_minutes = self.config.get("update_interval_minutes", DEFAULT_INTERVAL_MINUTES)
        self.initial_delay_seconds = self.config.get("initial_delay_seconds", DEFAULT_INITIAL_DELAY_SECONDS)

        self.base_icon_file = None
        for p in ICON_PATHS:
            if os.path.exists(p):
                self.base_icon_file = p
                break
        
        fallback_icon = QIcon(self.base_icon_file) if self.base_icon_file else QIcon.fromTheme("system-software-install")
        self.base_icon = QIcon.fromTheme("purr", fallback_icon)
        self.tray = QSystemTrayIcon(self.base_icon, self.app)
        self.tray.setToolTip("🐾 Purr — Universal App Engine (Project Tuki)")

        self.update_count = 0
        self.last_summary = "Checking for updates..."
        self.breakdown = {}
        self.urgency = UrgencyLevel.NONE
        self.critical_packages = []
        self.unused_flatpaks = 0
        self.is_network_error = False

        # Android Window Position Memory State
        self.remember_android_positions = self.config.get("remember_android_positions", False)
        self.pending_geometries = {}
        self.memory_debounce_timer = QTimer(self.app)
        self.memory_debounce_timer.setSingleShot(True)
        self.memory_debounce_timer.timeout.connect(self.flush_pending_geometries)
        self.dbus_tracker_active = False

        # Context Menu
        self.menu = QMenu()
        self.build_menu()
        self.tray.setContextMenu(self.menu)

        # Tray Click Activation
        self.tray.activated.connect(self.on_tray_activated)
        self.tray.show()

        # Thread Pool for background tasks
        self.threadpool = QThreadPool()

        # Sane Recurring Update Timer (Default 60 minutes)
        self.update_timer = QTimer()
        self.update_timer.timeout.connect(self.check_updates_background)
        self.update_timer.start(self.interval_minutes * 60 * 1000)

        # Sane Initial Check with delay (Default 15 seconds to allow network stack & VPNs to connect)
        QTimer.singleShot(self.initial_delay_seconds * 1000, self.check_updates_background)

        # Initial Android Desktop Sync & Position Memory (Only if waydroid-native recipe is configured)
        self.android_sync_timer = QTimer(self.app)
        self.android_sync_timer.timeout.connect(self.sync_active_android_windows)

        if is_waydroid_configured():
            QTimer.singleShot(5000, self.sync_android_desktop)
            if self.remember_android_positions:
                QTimer.singleShot(1500, self.start_android_window_memory)
            # Real-time Bidirectional Clipboard Synchronization with Android Container
            self.last_synced_clipboard = ""
            self.start_host_clipboard_watcher()

        # File-based instant refresh trigger watcher (IPC with CLI purr upgrade & install)
        self.trigger_file = os.path.expanduser("~/.cache/purr/refresh_trigger")
        os.makedirs(os.path.dirname(self.trigger_file), exist_ok=True)
        if not os.path.exists(self.trigger_file):
            try:
                with open(self.trigger_file, "w") as f:
                    f.write("0")
            except Exception:
                pass

        self.file_watcher = QFileSystemWatcher([self.trigger_file], self.app)
        self.file_watcher.fileChanged.connect(self.on_refresh_triggered)

        # Periodic tick to process POSIX signals smoothly in Qt event loop
        self.sig_timer = QTimer(self.app)
        self.sig_timer.timeout.connect(lambda: None)
        self.sig_timer.start(500)

    def on_refresh_triggered(self, path=None):
        if not self.file_watcher.files():
            try:
                if os.path.exists(self.trigger_file):
                    self.file_watcher.addPath(self.trigger_file)
            except Exception:
                pass
        # Debounced instant refresh of updates and tray badge
        QTimer.singleShot(300, self.check_updates_background)

    def create_urgency_icon(self, urgency):
        if urgency == UrgencyLevel.NONE:
            return self.base_icon

        pixmap = self.base_icon.pixmap(128, 128)
        if pixmap.isNull():
            return self.base_icon

        painter = QPainter(pixmap)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)

        # Urgency Color Mapping
        if urgency == UrgencyLevel.HIGH:
            color = QColor(229, 57, 53)      # Crimson Coral (High Urgency / Critical System / Large Backlog)
            halo_color = QColor(255, 205, 210, 160)
        elif urgency == UrgencyLevel.MEDIUM:
            color = QColor(255, 152, 0)     # Warm Amber (Medium Backlog)
            halo_color = QColor(255, 224, 178, 160)
        else: # LOW
            color = QColor(0, 188, 212)      # Cyan / Teal (Low / Minor Updates)
            halo_color = QColor(178, 235, 242, 160)

        # Pip indicator dimensions (top-right pip)
        pip_size = 32
        x = 128 - pip_size - 4
        y = 4

        # Outer soft glow halo
        painter.setBrush(QBrush(halo_color))
        painter.setPen(Qt.PenStyle.NoPen)
        painter.drawEllipse(x - 3, y - 3, pip_size + 6, pip_size + 6)

        # Solid color pip with crisp white border
        painter.setBrush(QBrush(color))
        painter.setPen(QPen(QColor(255, 255, 255), 4))
        painter.drawEllipse(x, y, pip_size, pip_size)

        painter.end()
        return QIcon(pixmap)

    def build_menu(self):
        self.menu.clear()

        # Title / Status Header with Urgency indicator
        if self.is_network_error and self.update_count == 0:
            header_text = f"🐾 Purr: Network Offline (Retrying...)"
        elif self.update_count > 0:
            if self.urgency == UrgencyLevel.HIGH:
                status_tag = "Urgent / Core Updates Available"
            elif self.urgency == UrgencyLevel.MEDIUM:
                status_tag = "Updates Available"
            else:
                status_tag = "Minor Updates Available"
            header_text = f"🐾 Purr: {self.update_count} {status_tag}"
        else:
            header_text = "🐾 Purr (Project Tuki)"
        
        title_action = QAction(header_text, self.menu)
        title_action.setEnabled(False)
        self.menu.addAction(title_action)
        self.menu.addSeparator()

        # Prominent Upgrade Action if updates exist
        if self.update_count > 0:
            upgrade_text = f"🚀 Upgrade System Now ({self.update_count} packages)"
            upgrade_action = QAction(upgrade_text, self.menu)
            upgrade_action.triggered.connect(self.open_system_upgrade)
            self.menu.addAction(upgrade_action)

            # Details breakdown
            if self.last_summary:
                info_action = QAction(f"   ↳ {self.last_summary}", self.menu)
                info_action.setEnabled(False)
                self.menu.addAction(info_action)

            if self.critical_packages:
                crit_text = f"   ⚠️ Core components: {', '.join(self.critical_packages[:3])}"
                crit_action = QAction(crit_text, self.menu)
                crit_action.setEnabled(False)
                self.menu.addAction(crit_action)

            self.menu.addSeparator()

        # Maintenance Action: Prune EOL / Unused Flatpak runtimes
        if self.unused_flatpaks > 0:
            flatpak_clean_act = QAction(f"🧹 Clean {self.unused_flatpaks} Unsupported / EOL Flatpak Runtime(s)", self.menu)
            flatpak_clean_act.triggered.connect(self.clean_eol_flatpaks)
            self.menu.addAction(flatpak_clean_act)
            self.menu.addSeparator()

        # App Search & Install
        search_action = QAction("🔍 Search & Install Apps (purr)", self.menu)
        search_action.triggered.connect(self.open_purr_terminal)
        self.menu.addAction(search_action)

        # Quick Input Dialog
        quick_action = QAction("⚡ Quick App Search...", self.menu)
        quick_action.triggered.connect(self.quick_search_dialog)
        self.menu.addAction(quick_action)

        self.menu.addSeparator()

        # Manual Update Check
        self.update_action = QAction("🔄 Check for Updates Now", self.menu)
        self.update_action.triggered.connect(self.check_updates_manual)
        self.menu.addAction(self.update_action)

        # Upgrade action fallback when system is clean
        if self.update_count == 0:
            manual_up_act = QAction("📦 Run Full System Upgrade (pacman + yay + flatpak)", self.menu)
            manual_up_act.triggered.connect(self.open_system_upgrade)
            self.menu.addAction(manual_up_act)

        self.menu.addSeparator()

        # Companion Stores Submenu
        stores_menu = self.menu.addMenu("🛍️ Alternative GUI Stores")
        
        bauh_act = QAction("Bauh Universal Package Manager", stores_menu)
        bauh_act.triggered.connect(lambda: subprocess.Popen(['bauh'], start_new_session=True))
        stores_menu.addAction(bauh_act)

        pamac_act = QAction("Pamac Software Center", stores_menu)
        pamac_act.triggered.connect(lambda: subprocess.Popen(['pamac-manager'], start_new_session=True))
        stores_menu.addAction(pamac_act)

        gear_act = QAction("Gear Lever (AppImage Manager)", stores_menu)
        gear_act.triggered.connect(lambda: subprocess.Popen(['gearlever'], start_new_session=True))
        stores_menu.addAction(gear_act)

        # Android Subsystem Submenu (Only visible if waydroid-native recipe is configured)
        if is_waydroid_configured():
            android_menu = self.menu.addMenu("📱 Android Subsystem (Waydroid)")
            
            waydroid_bin = shutil.which("waydroid") or "/usr/bin/waydroid"
            ui_act = QAction("▶ Open Android Subsystem UI", android_menu)
            ui_act.triggered.connect(lambda: subprocess.Popen([waydroid_bin, 'show-full-ui'], start_new_session=True))
            android_menu.addAction(ui_act)

            sync_act = QAction("🔄 Sync Android Desktop Apps & Kickoff", android_menu)
            sync_act.triggered.connect(self.sync_android_desktop)
            android_menu.addAction(sync_act)

            android_menu.addSeparator()

            play_act = QAction("⚡ Google Play Store", android_menu)
            play_act.triggered.connect(lambda: subprocess.Popen(['purr', 'apk', 'launch', 'com.android.vending'], start_new_session=True))
            android_menu.addAction(play_act)

            aurora_act = QAction("🛒 Aurora Store", android_menu)
            aurora_act.triggered.connect(lambda: subprocess.Popen(['purr', 'apk', 'launch', 'com.aurora.store'], start_new_session=True))
            android_menu.addAction(aurora_act)

            fdroid_act = QAction("📦 F-Droid", android_menu)
            fdroid_act.triggered.connect(lambda: subprocess.Popen(['purr', 'apk', 'launch', 'org.fdroid.fdroid'], start_new_session=True))
            android_menu.addAction(fdroid_act)

            settings_act = QAction("⚙️ Android Settings", android_menu)
            settings_act.triggered.connect(lambda: subprocess.Popen(['purr', 'apk', 'launch', 'com.android.settings'], start_new_session=True))
            android_menu.addAction(settings_act)

            android_menu.addSeparator()

            # Subsystem Presentation Mode Switcher (Multi-Window vs Full Tablet UI)
            try:
                from recipes.waydroid_native.system_tuning import get_waydroid_prop
                is_multi = get_waydroid_prop("persist.waydroid.multi_windows", "true").lower() == "true"
            except Exception:
                is_multi = True

            mode_multi_act = QAction("🪟 Multi-Window Mode (Floating Apps)", android_menu)
            mode_multi_act.setCheckable(True)
            mode_multi_act.setChecked(is_multi)
            mode_multi_act.triggered.connect(lambda: self.switch_android_mode(True))
            android_menu.addAction(mode_multi_act)

            mode_full_act = QAction("🎮 Full Subsystem Tablet UI (Gaming & Fullscreen)", android_menu)
            mode_full_act.setCheckable(True)
            mode_full_act.setChecked(not is_multi)
            mode_full_act.triggered.connect(lambda: self.switch_android_mode(False))
            android_menu.addAction(mode_full_act)

            android_menu.addSeparator()

            memory_act = QAction("📍 Auto-Remember App Positions [Opt-in]", android_menu)
            memory_act.setCheckable(True)
            memory_act.setChecked(self.remember_android_positions)
            memory_act.toggled.connect(self.toggle_android_window_memory)
            android_menu.addAction(memory_act)

            paste_act = QAction("📋 Paste Host Clipboard into Active Android App", android_menu)
            paste_act.triggered.connect(self.paste_host_clipboard_to_android)
            android_menu.addAction(paste_act)

            restart_act = QAction("🔄 Restart Waydroid Session", android_menu)
            restart_act.triggered.connect(self.restart_waydroid_session)
            android_menu.addAction(restart_act)

        # Desktop Integration & Preferences Submenu
        kde_menu = self.menu.addMenu("⚙️ KDE Plasma Desktop Integrations")
        
        fav_act = QAction("⭐ Toggle Kickoff Favorites", kde_menu)
        fav_act.triggered.connect(lambda: subprocess.Popen(['purr', 'integrate', '--favorite'], start_new_session=True))
        kde_menu.addAction(fav_act)

        pin_act = QAction("📌 Toggle Task Manager Pin", kde_menu)
        pin_act.triggered.connect(lambda: subprocess.Popen(['purr', 'integrate', '--pin'], start_new_session=True))
        kde_menu.addAction(pin_act)

        auto_act = QAction("🚀 Toggle Autostart on Login", kde_menu)
        auto_act.triggered.connect(lambda: subprocess.Popen(['purr', 'integrate', '--autostart'], start_new_session=True))
        kde_menu.addAction(auto_act)

        kde_menu.addSeparator()

        interval_act = QAction(f"⏱️ Check Frequency (Currently: {self.interval_minutes}m)...", kde_menu)
        interval_act.triggered.connect(self.change_interval_dialog)
        kde_menu.addAction(interval_act)

        self.menu.addSeparator()

        # About Box
        about_act = QAction("ℹ️ About Project Tuki & PSL", self.menu)
        about_act.triggered.connect(self.show_about)
        self.menu.addAction(about_act)

        # Quit
        quit_act = QAction("🚪 Quit Purr Tray", self.menu)
        quit_act.triggered.connect(self.quit_app)
        self.menu.addAction(quit_act)

    def on_tray_activated(self, reason):
        if reason == QSystemTrayIcon.ActivationReason.Trigger:
            if self.update_count > 0:
                self.open_system_upgrade()
            else:
                self.open_purr_terminal()

    def get_terminal_cmd(self, subcmd_or_query=None):
        if not subcmd_or_query:
            cmd = ["purr"]
            title = "Purr"
        elif subcmd_or_query == "upgrade":
            cmd = ["purr", "upgrade"]
            title = "Purr System Upgrade"
        else:
            cmd = ["purr", subcmd_or_query]
            title = f"Purr — {subcmd_or_query}"

        terminals = [
            ("konsole", lambda c: ["konsole", "--desktopfile", "purr.desktop", "-qwindowtitle", title, "-qwindowicon", "purr", "-e"] + c),
            ("kitty", lambda c: ["kitty", "--name", "purr", "--class", "purr", "-e"] + c),
            ("alacritty", lambda c: ["alacritty", "--class", "purr,purr", "-e"] + c),
            ("gnome-terminal", lambda c: ["gnome-terminal", "--class=purr", "--"] + c),
            ("xterm", lambda c: ["xterm", "-class", "purr", "-e"] + c)
        ]
        for term, build_fn in terminals:
            if shutil.which(term):
                return build_fn(cmd)
        return ["konsole", "--desktopfile", "purr.desktop", "-qwindowtitle", title, "-qwindowicon", "purr", "-e"] + cmd

    def open_purr_terminal(self, query=None):
        cmd = self.get_terminal_cmd(query)
        subprocess.Popen(cmd, start_new_session=True)

    def open_system_upgrade(self):
        cmd = self.get_terminal_cmd("upgrade")
        subprocess.Popen(cmd, start_new_session=True)
        # Schedule check 30 seconds later to update badge
        QTimer.singleShot(30000, self.check_updates_background)

    def clean_eol_flatpaks(self):
        self.tray.showMessage("🐾 Purr", "Pruning unused and EOL Flatpak runtimes in background...", QSystemTrayIcon.MessageIcon.Information, 3000)
        class Cleaner(QRunnable):
            def __init__(self, callback):
                super().__init__()
                self.callback = callback
            def run(self):
                subprocess.run(['flatpak', 'uninstall', '--unused', '-y', '--noninteractive'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                QTimer.singleShot(1000, self.callback)
        self.threadpool.start(Cleaner(self.check_updates_background))

    def change_interval_dialog(self):
        items = ["15 minutes", "30 minutes", "60 minutes (1 hour - Default)", "120 minutes (2 hours)", "240 minutes (4 hours)", "360 minutes (6 hours)"]
        current_idx = 2
        for idx, itm in enumerate(items):
            if f"{self.interval_minutes} minutes" in itm:
                current_idx = idx
                break
                
        item, ok = QInputDialog.getItem(
            None,
            "🐾 Purr Update Check Interval",
            "Select automatic update check frequency:",
            items,
            current_idx,
            False
        )
        if ok and item:
            try:
                mins = int(item.split()[0])
                self.interval_minutes = mins
                self.config["update_interval_minutes"] = mins
                save_config(self.config)
                self.update_timer.stop()
                self.update_timer.start(self.interval_minutes * 60 * 1000)
                self.tray.showMessage("🐾 Purr", f"Update check interval updated to every {mins} minutes.", QSystemTrayIcon.MessageIcon.Information, 3000)
                self.build_menu()
            except Exception:
                pass

    def sync_android_desktop(self):
        if not is_waydroid_configured():
            return
        
        class SyncRunnable(QRunnable):
            def __init__(self, callback):
                super().__init__()
                self.callback = callback
            def run(self):
                try:
                    from recipes.waydroid_native.desktop_sync import sync_android_desktop_entries
                    ok, entries = sync_android_desktop_entries()
                    QTimer.singleShot(0, lambda: self.callback(True, len(entries)))
                except Exception as e:
                    QTimer.singleShot(0, lambda: self.callback(False, str(e)))

        def on_done(success, info):
            if success:
                if info > 0:
                    self.tray.showMessage("🐾 Purr Android Subsystem", f"Synced {info} Android app launchers to Kickoff menu.", QSystemTrayIcon.MessageIcon.Information, 4000)
            else:
                self.tray.showMessage("🐾 Purr Error", f"Failed to sync Android apps: {info}", QSystemTrayIcon.MessageIcon.Warning, 4000)

        self.threadpool.start(SyncRunnable(on_done))

    def switch_android_mode(self, multi_windows: bool):
        mode_label = "Multi-Window Freeform Mode" if multi_windows else "Full Subsystem Tablet UI"
        self.tray.showMessage(
            "🐾 Purr Android Subsystem",
            f"Switching Android Subsystem to {mode_label}...\nRestarting session in background.",
            QSystemTrayIcon.MessageIcon.Information,
            4000
        )
        self.tray.setToolTip(f"🐾 Purr: Switching Android Subsystem to {mode_label}...")

        class ModeSwitchRunnable(QRunnable):
            def __init__(self, target_multi, callback):
                super().__init__()
                self.target_multi = target_multi
                self.callback = callback

            def run(self):
                try:
                    from recipes.waydroid_native.system_tuning import set_waydroid_prop
                    set_waydroid_prop("persist.waydroid.multi_windows", "true" if self.target_multi else "false")
                    # Restart session
                    subprocess.run(["sudo", "/usr/bin/python3", "/usr/lib/waydroid/waydroid.py", "session", "stop"], capture_output=True)
                    subprocess.run(["systemctl", "--user", "restart", "waydroid-session.service"], capture_output=True)
                    time.sleep(2.0)
                    if not self.target_multi:
                        waydroid_bin = shutil.which("waydroid") or "/usr/bin/waydroid"
                        subprocess.Popen([waydroid_bin, "show-full-ui"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    QTimer.singleShot(0, lambda: self.callback(True, self.target_multi))
                except Exception as e:
                    QTimer.singleShot(0, lambda: self.callback(False, str(e)))

        def on_mode_switched(success, info):
            if success:
                label = "Multi-Window Freeform Mode" if info else "Full Subsystem Tablet UI"
                self.tray.showMessage(
                    "🐾 Purr Android Subsystem",
                    f"Android Subsystem is now active in {label}.",
                    QSystemTrayIcon.MessageIcon.Information,
                    4000
                )
                self.create_menu()
            else:
                self.tray.showMessage(
                    "🐾 Purr Error",
                    f"Failed to switch Android Subsystem mode: {info}",
                    QSystemTrayIcon.MessageIcon.Warning,
                    4000
                )

        self.threadpool.start(ModeSwitchRunnable(multi_windows, on_mode_switched))

    def restart_waydroid_session(self):
        self.tray.showMessage("🐾 Purr Android Subsystem", "Restarting Waydroid container and session...", QSystemTrayIcon.MessageIcon.Information, 3000)
        subprocess.Popen(['purr', 'apk', 'session', 'restart'], start_new_session=True)

    def paste_host_clipboard_to_android(self):
        def _do_paste():
            import time
            time.sleep(0.35)  # Allow tray popup to close and restore window focus
            subprocess.run(['purr', 'apk', 'paste'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        threading.Thread(target=_do_paste, daemon=True).start()

    def start_android_window_memory(self):
        if not is_waydroid_configured():
            return
        self.android_sync_timer.start(2500)
        self.dbus_tracker_active = True

    def stop_android_window_memory(self):
        self.android_sync_timer.stop()
        self.dbus_tracker_active = False

    def sync_active_android_windows(self):
        if not self.remember_android_positions or not is_waydroid_configured():
            return
        try:
            from recipes.waydroid_native.window_memory import get_active_android_windows, save_pkg_bounds, load_all_bounds
            active = get_active_android_windows()
            if not active:
                return
            saved = load_all_bounds()
            for pkg, info in active.items():
                l, t, r, b = info["left"], info["top"], info["right"], info["bottom"]
                s_info = saved.get(pkg)
                if not s_info or abs(s_info.get("left", 0) - l) > 10 or abs(s_info.get("top", 0) - t) > 10 or abs(s_info.get("width", 0) - (r - l)) > 10 or abs(s_info.get("height", 0) - (b - t)) > 10:
                    save_pkg_bounds(pkg, l, t, r, b)
        except Exception:
            pass

    def start_host_clipboard_watcher(self):
        """
        Spawns a real-time wl-paste watcher thread that listens for Wayland clipboard updates
        and injects them directly into Android's system clipboard via PurrClipHelper.
        """
        if not is_waydroid_configured() or not shutil.which("wl-paste"):
            return

        def _watcher():
            import shlex
            try:
                proc = subprocess.Popen(
                    ["wl-paste", "--watch", "sh", "-c", "echo __PURR_CLIP__"],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                    text=True
                )
                for line in proc.stdout:
                    try:
                        res = subprocess.run(["wl-paste", "--no-newline"], capture_output=True, text=True, timeout=2)
                        text = res.stdout
                        if text and text != self.last_synced_clipboard:
                            self.last_synced_clipboard = text
                            cmd_str = f"PATH=/system/bin:/system/xbin am broadcast -a dev.purr.cliphelper.SET_CLIP -n dev.purr.cliphelper/.ClipReceiver -f 0x10000000 --es text {shlex.quote(text)}"
                            subprocess.run(["sudo", "lxc-attach", "-P", "/var/lib/waydroid/lxc", "-n", "waydroid", "--",
                                            "/system/bin/sh", "-c", cmd_str],
                                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
                    except Exception:
                        pass
            except Exception:
                pass

        threading.Thread(target=_watcher, daemon=True).start()

    def toggle_android_window_memory(self, checked):
        self.remember_android_positions = checked
        self.config["remember_android_positions"] = checked
        save_config(self.config)
        if checked:
            self.start_android_window_memory()
            self.tray.showMessage("🐾 Purr Android Subsystem", "Auto-remember app positions enabled.", QSystemTrayIcon.MessageIcon.Information, 3000)
        else:
            self.stop_android_window_memory()
            self.tray.showMessage("🐾 Purr Android Subsystem", "Auto-remember app positions disabled.", QSystemTrayIcon.MessageIcon.Information, 3000)

    def queue_geometry_update(self, app_id, x, y, w, h):
        if not self.remember_android_positions:
            return
        self.pending_geometries[app_id] = (x, y, w, h)
        # Debounce: wait 1500ms after user finishes dragging before persisting to disk
        self.memory_debounce_timer.start(1500)

    def flush_pending_geometries(self):
        if not self.pending_geometries:
            return
        try:
            from recipes.waydroid_native.window_memory import save_app_window_rule
            for app_id, (x, y, w, h) in list(self.pending_geometries.items()):
                save_app_window_rule(app_id, x, y, w, h)
            self.pending_geometries.clear()
        except Exception:
            pass

    def quick_search_dialog(self):
        text, ok = QInputDialog.getText(
            None,
            "🐾 Purr Quick App Search",
            "Enter application name or keyword:",
            QLineEdit.EchoMode.Normal,
            ""
        )
        if ok and text.strip():
            self.open_purr_terminal(text.strip())

    def check_updates_background(self):
        self.tray.setToolTip("🐾 Purr: Checking for system & package updates...")
        runnable = UpdateCheckerRunnable()
        runnable.signals.finished.connect(self.on_updates_checked)
        self.threadpool.start(runnable)

    def check_updates_manual(self):
        self.tray.showMessage("🐾 Purr", "Checking for system and package updates...", QSystemTrayIcon.MessageIcon.Information, 2000)
        self.check_updates_background()

    def on_updates_checked(self, count, summary, breakdown, urgency, critical_packages, is_network_error, unused_flatpaks):
        self.update_count = count
        self.last_summary = summary
        self.breakdown = breakdown
        self.urgency = urgency
        self.critical_packages = critical_packages
        self.is_network_error = is_network_error
        self.unused_flatpaks = unused_flatpaks

        # If network error, schedule a faster retry (2 minutes adaptive backoff)
        if is_network_error and count == 0:
            self.tray.setToolTip("🐾 Purr: Network unavailable (retrying in 2m)...")
            self.update_timer.stop()
            self.update_timer.start(BACKOFF_RETRY_SECONDS * 1000)
            self.build_menu()
            return
        else:
            # Restore normal timer interval
            self.update_timer.stop()
            self.update_timer.start(self.interval_minutes * 60 * 1000)

        # Update Color-Coded Urgency Icon
        self.tray.setIcon(self.create_urgency_icon(urgency))

        if count > 0:
            crit_msg = f"\n⚠️ Core updates: {', '.join(critical_packages[:3])}" if critical_packages else ""
            eol_msg = f"\n🧹 {unused_flatpaks} EOL Flatpak runtime(s) can be pruned" if unused_flatpaks > 0 else ""
            self.tray.setToolTip(f"🐾 Purr: {count} Updates Available\n{summary}{crit_msg}{eol_msg}\n(Click to upgrade)")
            
            # Show toast notification
            if urgency == UrgencyLevel.HIGH:
                title = "🚨 Critical / Large Updates Available"
            else:
                title = "🐾 Software Updates Available"

            self.tray.showMessage(
                title,
                f"{count} updates available:\n{summary}{crit_msg}\nClick tray icon to upgrade now.",
                QSystemTrayIcon.MessageIcon.Information,
                5000
            )
        else:
            eol_msg = f" ({unused_flatpaks} EOL runtimes prunable)" if unused_flatpaks > 0 else ""
            self.tray.setToolTip(f"🐾 Purr: System is fully up to date{eol_msg}\n(Next check in {self.interval_minutes}m)")

        self.build_menu()

    def show_about(self):
        msg = QMessageBox()
        msg.setWindowTitle("About Purr (Project Tuki)")
        msg.setIconPixmap(self.base_icon.pixmap(64, 64))
        msg.setText("<h3>🐾 Purr — Purr Universal App Engine (PUAE)</h3>")
        msg.setInformativeText(
            "<b>Version:</b> 1.0.0 (Project Tuki)<br>"
            "<b>Dedicated to:</b> Tuki (2019–2024 — The Calm Before and After All Storms)<br><br>"
            "<b>Author:</b> Arafat Zahan (<a href='https://github.com/kuasha420'>@kuasha420</a>)<br>"
            "<b>Stewardship:</b> Purrfect Software Limited (PSL) & Purrfect Universe Inc.<br>"
            "<b>License:</b> MIT License with CSP-IP (ICARO-42/b Ordinance)<br><br>"
            "<i>Unapologetically Arch Linux. Unapologetically KDE Plasma.</i>"
        )
        msg.exec()

    def quit_app(self):
        self.tray.hide()
        self.app.quit()

    def run(self):
        return self.app.exec()

def main():
    parser = argparse.ArgumentParser(
        prog="purr-tray",
        description="🐾 Purr System Tray Indicator (Project Tuki)"
    )
    parser.add_argument("-i", "--interval", type=int, default=None, help="Update check frequency in minutes (default: 60)")
    parser.add_argument("--initial-delay", type=int, default=None, help="Initial check delay in seconds after boot/login (default: 15)")
    args, _ = parser.parse_known_args()

    app = PurrTrayApp(interval_minutes=args.interval, initial_delay_seconds=args.initial_delay)

    def handle_sigusr1(signum, frame):
        QTimer.singleShot(100, app.check_updates_background)

    signal.signal(signal.SIGINT, signal.SIG_DFL)
    signal.signal(signal.SIGTERM, signal.SIG_DFL)
    try:
        signal.signal(signal.SIGUSR1, handle_sigusr1)
    except Exception:
        pass

    sys.exit(app.run())

if __name__ == '__main__':
    main()
